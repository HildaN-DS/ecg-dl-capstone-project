# CPU-only, research-use FastAPI image. Frozen artifacts are mounted at runtime.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ECG_ARTIFACTS_DIR=/artifacts \
    ECG_DEVICE=cpu \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

WORKDIR /app

# Install PyTorch from the official CPU-only wheel repository.
RUN python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch==2.6.0"
COPY requirements-api.txt /app/requirements-api.txt
RUN python -m pip install "numpy==2.1.3" -r /app/requirements-api.txt

# Only the application source enters the image; never copy checkpoints/ECG data.
COPY src/ /app/src/
RUN useradd --system --create-home --shell /usr/sbin/nologin ecguser
USER ecguser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).read()"]

# Bind published ports to host loopback ONLY (docker compose config / run -p 127.0.0.1:8000:8000).
CMD ["python", "-m", "uvicorn", "src.ecg.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
